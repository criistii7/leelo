{
  "id": "./",
  "name": "Léelo · audios de WhatsApp a texto",
  "short_name": "Léelo",
  "description": "Pasa audios de WhatsApp a texto gratis, busca palabras y mira en qué minuto se dicen. Todo ocurre en tu dispositivo.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#faf6ef",
  "theme_color": "#faf6ef",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "iconos/icono-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "iconos/icono-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "iconos/icono-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        {
          "name": "audio",
          "accept": ["audio/*", "video/*", ".opus", ".ogg", ".oga", ".m4a", ".mp3", ".wav", ".aac", ".amr", ".webm", ".mp4"]
        }
      ]
    }
  }
}
